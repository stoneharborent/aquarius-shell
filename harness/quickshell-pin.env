# =============================================================================
# Which Quickshell the Aquarius Shell is tested against
# =============================================================================
# Quickshell is the program that RUNS this repository (the command is `qs`).
# AquariusOS does not use the one Fedora packages — Fedora's is a snapshot of
# 0.2.1, which has no Quickshell.Networking and no Quickshell.Bluetooth, so the
# shell does not load on it at all. The OS compiles its own, and this is the
# version it compiles.
#
# ⚠️ THIS FILE IS A COPY. The original lives in the os-image repository at
#    aquarius-os.env (QUICKSHELL_VERSION / QUICKSHELL_COMMIT), which is what the
#    real operating system is built from. The copy is here because CI in THIS
#    repository cannot read that one, and the load check would otherwise be
#    testing the shell against a different Quickshell than the one people run.
#
#    CHANGE ONE, CHANGE BOTH. If these two ever disagree, the load check is
#    proving something about a Quickshell nobody has.
# =============================================================================

QUICKSHELL_VERSION="v0.3.1"
QUICKSHELL_COMMIT="1a4716cde794a59928d9d9fc15f2afc7a95de360"
