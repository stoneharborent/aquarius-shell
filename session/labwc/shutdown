# =============================================================================
# labwc shutdown — what runs as labwc is exiting
# =============================================================================
# The mirror image of `autostart`. labwc runs this as a shell script when it is
# preparing to terminate, while WAYLAND_DISPLAY is still valid.
#
# All it does is undo the one thing autostart did: tell systemd the graphical
# session is over, so the portals, notification daemon and keyring agent stop
# with it instead of lingering as orphans into the next login.
# =============================================================================

systemctl --user stop graphical-session.target 2>/dev/null || true
